    "@jsquash/webp": "^1.5.0",
    "client-zip": "^2.5.1",
    "gifenc": "^1.0.3",
    "libheif-js": "^1.23.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "utif2": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@types/node": "^24.13.3",
